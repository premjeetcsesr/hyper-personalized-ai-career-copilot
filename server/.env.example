# ========================================================
# Technovoo1 AI Career Co-Pilot - Server Environment Variables
# Render Deployment Reference: Add these in Render Dashboard -> Environment
# ========================================================

# Server Port (Render sets this dynamically, e.g. 10000, default is 5000)
PORT=5000

# Environment Mode ('production' on Render, 'development' locally)
NODE_ENV=production

# MongoDB Atlas URI (connection string with username and password)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/technova_career_copilot?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=technovoo1_super_secure_jwt_secret_key_2026

# Google Gemini API Key for AI Analysis & Roadmaps
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional fallback)
OPENAI_API_KEY=

# GitHub Personal Access Token (for extended rate limits in GitHub analyzer)
GITHUB_TOKEN=

# Enable Mock Demo Fallback (true = resilient static data, false = live AI & DB)
ENABLE_DEMO_FALLBACK=false

# Allowed Frontend URL(s) for CORS. Can be comma-separated:
# Example: https://your-app.vercel.app,http://localhost:5173
CLIENT_URL=https://your-app.vercel.app,http://localhost:5173
