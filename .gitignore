# Dependencies
node_modules/
*/node_modules/

# Environment files (NEVER commit secrets to public GitHub)
.env
.env.local
.env.*.local
*.env
server/.env
client/.env

# Keep template env files
!.env.example
!server/.env.example
!client/.env.example

# Build Outputs
dist/
dist-ssr/
client/dist/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Uploads directory contents (keep folder structure with .gitkeep)
server/uploads/*
!server/uploads/.gitkeep

# IDE and OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Vercel deployment cache
.vercel
